
cat > /root/finalisasi-https-kasir.sh <<'SCRIPT'
#!/bin/bash
set -Eeuo pipefail

API="api.kberkah88.my.id"
DB="db.kberkah88.my.id"
CERT="/etc/letsencrypt/live/$API"
WEBROOT="/var/www/html"
API_CONF="/etc/nginx/sites-available/kasir-api"
DB_CONF="/etc/nginx/sites-available/kasir-db"
BACKUP="/root/nginx-final-backup-$(date +%Y%m%d-%H%M%S)"

echo "=========================================="
echo " FINALISASI HTTPS KASIR BERKAH 88"
echo "=========================================="

# 1. Pemeriksaan awal
for file in "$CERT/fullchain.pem" "$CERT/privkey.pem"; do
    if [ ! -f "$file" ]; then
        echo "ERROR: Sertifikat tidak ditemukan: $file"
        exit 1
    fi
done

if ! openssl x509 -in "$CERT/fullchain.pem" -noout -ext subjectAltName | grep -q "DNS:$API"; then
    echo "ERROR: Sertifikat tidak mencakup $API"
    exit 1
fi

if ! openssl x509 -in "$CERT/fullchain.pem" -noout -ext subjectAltName | grep -q "DNS:$DB"; then
    echo "ERROR: Sertifikat tidak mencakup $DB"
    exit 1
fi

if [ ! -S /run/php/php8.1-fpm.sock ]; then
    echo "ERROR: PHP-FPM socket tidak ditemukan."
    exit 1
fi

if [ ! -f /etc/nginx/.pma_htpasswd ]; then
    echo "ERROR: File autentikasi phpMyAdmin tidak ditemukan."
    exit 1
fi

# 2. Backup
mkdir -p "$BACKUP"
[ ! -f "$API_CONF" ] || cp -a "$API_CONF" "$BACKUP/"
[ ! -f "$DB_CONF" ] || cp -a "$DB_CONF" "$BACKUP/"

echo "[OK] Backup: $BACKUP"

# 3. Folder challenge SSL
mkdir -p "$WEBROOT/.well-known/acme-challenge"
chmod 755 "$WEBROOT"
chmod 755 "$WEBROOT/.well-known"
chmod 755 "$WEBROOT/.well-known/acme-challenge"

# 4. Virtual host API
cat > "$API_CONF" <<'EOF'
server {
    listen 80;
    server_name api.kberkah88.my.id;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name api.kberkah88.my.id;

    ssl_certificate /etc/letsencrypt/live/api.kberkah88.my.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.kberkah88.my.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 55m;

    location /socket.io/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
EOF

# 5. Virtual host phpMyAdmin
cat > "$DB_CONF" <<'EOF'
server {
    listen 80;
    server_name db.kberkah88.my.id;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name db.kberkah88.my.id;

    ssl_certificate /etc/letsencrypt/live/api.kberkah88.my.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.kberkah88.my.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/phpmyadmin;
    index index.php index.html;

    auth_basic "Database Administration";
    auth_basic_user_file /etc/nginx/.pma_htpasswd;

    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/html;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.1-fpm.sock;
    }

    location ~ /\. {
        deny all;
    }
}
EOF

# 6. Pastikan kedua situs aktif
ln -sfn "$API_CONF" /etc/nginx/sites-enabled/kasir-api
ln -sfn "$DB_CONF" /etc/nginx/sites-enabled/kasir-db

# 7. Hook reload Nginx setelah SSL diperpanjang
mkdir -p /etc/letsencrypt/renewal-hooks/deploy

cat > /etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh <<'EOF'
#!/bin/sh
/usr/sbin/nginx -t && /bin/systemctl reload nginx
EOF

chmod 755 /etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh

# 8. Aktifkan timer Certbot jika tersedia
if systemctl list-unit-files certbot.timer --no-legend | grep -q 'certbot.timer'; then
    systemctl enable --now certbot.timer
    echo "[OK] Certbot auto-renew timer aktif."
else
    echo "[PERINGATAN] certbot.timer tidak ditemukan."
fi

# 9. Validasi sebelum reload
echo
echo "========== VALIDASI NGINX =========="
nginx -t

systemctl reload nginx

# 10. Pengujian endpoint
echo
echo "========== PENGUJIAN HTTPS =========="

API_CODE=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 15 "https://$API/" || true)
DB_CODE=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 15 "https://$DB/" || true)
HTTP_CODE=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 15 "http://$API/" || true)

echo "API HTTPS       : $API_CODE"
echo "phpMyAdmin HTTPS: $DB_CODE"
echo "HTTP redirect   : $HTTP_CODE"

echo
echo "========== STATUS PORT =========="
ss -lntp | grep -E ':(80|443|4000)\b' || true

echo
echo "========== STATUS LAYANAN =========="
systemctl is-active nginx
systemctl is-active kasir-backend
systemctl is-active mariadb

echo
echo "=========================================="
echo " FINALISASI SELESAI"
echo " Backup: $BACKUP"
echo "=========================================="
SCRIPT

chmod +x /root/finalisasi-https-kasir.sh
bash /root/finalisasi-https-kasir.sh
