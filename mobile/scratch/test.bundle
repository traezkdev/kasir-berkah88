      shadowRadius: 6,
      elevation: 2
    },
    sectionHeader: {
      flexDirection: 'row',
      alignItems: 'center',
      gap: 12,
      padding: 16,
      borderBottomWidth: 1,
      borderBottomColor: '#f1f5f9'
    },
    sectionIconWrap: {
      width: 38,
      height: 38,
      borderRadius: 9,
      alignItems: 'center',
      justifyContent: 'center'
    },
    sectionTitle: {
      fontSize: 15,
      fontWeight: '700',
      color: '#1e293b'
    },
    sectionSubtitle: {
      fontSize: 12,
      color: '#94a3b8',
      marginTop: 1
    },
    // Hourly Chart
    chartContainer: {
      paddingHorizontal: 16,
      paddingBottom: 16
    },
    chartInner: {
      flexDirection: 'row',
      alignItems: 'flex-end',
      gap: 8,
      paddingTop: 16,
      paddingRight: 32,
      minHeight: 160
    },
    barGroup: {
      alignItems: 'center',
      width: 32
    },
    bar: {
      width: 18,
      backgroundColor: '#3b82f6',
      borderRadius: 4,
      borderTopLeftRadius: 6,
      borderTopRightRadius: 6,
      marginBottom: 4
    },
    barCount: {
      fontSize: 10,
      color: '#475569',
      fontWeight: '600',
      marginBottom: 2
    },
    barLabel: {
      fontSize: 10,
      color: '#94a3b8'
    },
    // Table
    tableHeader: {
      flexDirection: 'row',
      backgroundColor: '#f8fafc',
      paddingHorizontal: 14,
      paddingVertical: 10,
      borderBottomWidth: 1,
      borderBottomColor: '#e2e8f0',
      alignItems: 'center'
    },
    th: {
      fontSize: 11,
      fontWeight: '700',
      color: '#64748b',
      textTransform: 'uppercase',
      letterSpacing: 0.3
    },
    tableRow: {
      flexDirection: 'row',
      alignItems: 'center',
      paddingHorizontal: 14,
      paddingVertical: 12,
      borderBottomWidth: 1,
      borderBottomColor: '#f1f5f9'
    },
    tableRowAlt: {
      backgroundColor: '#f8fafc'
    },
    rankBadge: {
      width: 28,
      height: 28,
      borderRadius: 14,
      backgroundColor: '#eff6ff',
      alignItems: 'center',
      justifyContent: 'center',
      marginRight: 4
    },
    rankText: {
      fontSize: 11,
      fontWeight: '700',
      color: '#1e40af'
    },
    td: {
      fontSize: 13,
      color: '#334155'
    },
    qtyBadge: {
      backgroundColor: '#1e40af',
      borderRadius: 12,
      paddingHorizontal: 8,
      paddingVertical: 3
    },
    qtyText: {
      fontSize: 11,
      fontWeight: '700',
      color: '#fff'
    },
    // Expense Cards
    expenseCard: {
      padding: 14,
      borderBottomWidth: 1,
      borderBottomColor: '#f1f5f9',
      gap: 8
    },
    expenseCardAlt: {
      backgroundColor: '#fafafa'
    },
    expenseTop: {
      flexDirection: 'row',
      justifyContent: 'space-between',
      alignItems: 'center'
    },
    expenseTime: {
      fontSize: 11,
      color: '#94a3b8',
      fontWeight: '500'
    },
    categoryBadge: {
      backgroundColor: '#f1f5f9',
      borderRadius: 6,
      paddingHorizontal: 8,
      paddingVertical: 2
    },
    categoryText: {
      fontSize: 10,
      color: '#64748b',
      fontWeight: '600'
    },
    expenseBottom: {
      flexDirection: 'row',
      justifyContent: 'space-between',
      alignItems: 'flex-start',
      gap: 12
    },
    expenseName: {
      fontSize: 13,
      fontWeight: '600',
      color: '#1e293b'
    },
    expenseNotes: {
      fontSize: 11,
      color: '#94a3b8',
      marginTop: 2
    },
    expenseAmount: {
      fontSize: 14,
      fontWeight: '800',
      color: '#dc2626',
      whiteSpace: 'nowrap'
    },
    // Pagination
    paginationRow: {
      flexDirection: 'row',
      alignItems: 'center',
      justifyContent: 'center',
      paddingVertical: 14,
      gap: 16,
      borderTopWidth: 1,
      borderTopColor: '#f1f5f9'
    },
    pageBtn: {
      padding: 8,
      borderRadius: 8,
      borderWidth: 1,
      borderColor: '#e2e8f0',
      backgroundColor: '#fff'
    },
    pageBtnDisabled: {
      borderColor: '#f1f5f9',
      backgroundColor: '#f8fafc'
    },
    pageInfo: {
      fontSize: 13,
      fontWeight: '600',
      color: '#475569'
    },
    // Empty States
    emptyState: {
      alignItems: 'center',
      paddingVertical: 30,
      paddingHorizontal: 20
    },
    emptyText: {
      fontSize: 13,
      color: '#94a3b8',
      textAlign: 'center'
    },
    emptyFullScreen: {
      alignItems: 'center',
      justifyContent: 'center',
      paddingVertical: 80,
