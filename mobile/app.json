{
  "expo": {
    "name": "Kasir Berkah88",
    "slug": "kasir-berkah88-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/logonew.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logonew.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logonew.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.traezkdev.kasirberkah88mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./with-min-sdk-fix",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Izinkan Kasir Berkah88 mengakses galeri Anda.",
          "savePhotosPermission": "Izinkan Kasir Berkah88 menyimpan gambar ke galeri.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Kasir Berkah88 mengakses foto Anda untuk banner promo."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "d8b99316-f80a-445e-a6b6-9f9a75f8f7af"
      }
    },
    "owner": "k2berkah88"
  }
}
