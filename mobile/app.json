{
  "expo": {
    "name": "Kasir Berkah 88",
    "slug": "kasir-berkah88-mobile",
    "version": "1.6.1",
    "orientation": "portrait",
    "icon": "./assets/logonew.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logonew.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logonew.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.traezkdev.kasirberkah88mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./with-min-sdk-fix",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "kotlinVersion": "2.1.20",
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so",
                "**/libjingle_peerconnection_so.so"
              ]
            }
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Izinkan Kasir Berkah88 mengakses galeri Anda.",
          "savePhotosPermission": "Izinkan Kasir Berkah88 menyimpan gambar ke galeri.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan Kasir Berkah88 mengakses foto Anda untuk banner promo."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "a01fe84c-a553-41b5-9a15-d9f3aaa1d627"
      }
    },
    "owner": "k3berkah88",
    "updates": {
      "url": "https://u.expo.dev/a01fe84c-a553-41b5-9a15-d9f3aaa1d627"
    },
    "runtimeVersion": "1.6.1"
  }
}
