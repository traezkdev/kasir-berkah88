{
    "cli": {
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "gradleCommand": ":app:assembleDebug"
            }
        },
        "preview": {
            "distribution": "internal",
            "runtimeVersion": "1.6.1",
            "android": {
                "buildType": "apk"
            },
            "channel": "preview"
        },
        "production": {
            "android": {
                "buildType": "apk"
            },
            "channel": "production"
        }
    }
}