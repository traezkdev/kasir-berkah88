DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_DATABASE=kasir
DB_PORT=3306
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=https://your-domain.com,http://localhost:4028

# Timezone Configuration (Set to Indonesia Western Time)
# IMPORTANT: Set this to Asia/Jakarta on production server to fix timestamp issues
TZ=Asia/Jakarta

# OneSignal Configuration
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_API_KEY=your_onesignal_api_key

# TURN Server Configuration (Self-hosted coturn)
# TURN_HOST = IP publik atau domain VPS Anda (contoh: 123.456.789.0 atau turn.domain.com)
# TURN_SECRET = Buat password acak yang kuat, HARUS SAMA dengan di coturn.conf
TURN_HOST=82.153.226.195
TURN_SECRET=ukysgdracuybwgbouyaewgnxufaywgeiurycgabweuyfrgerx
