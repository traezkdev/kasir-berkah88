DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_DATABASE=kasir
DB_PORT=3306
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=https://your-domain.com,http://localhost:4028

# Timezone Configuration (Set to Indonesia Western Time)
# IMPORTANT: Set this to Asia/Jakarta on production server to fix timestamp issues
TZ=Asia/Jakarta

# OneSignal Configuration
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_API_KEY=your_onesignal_api_key
